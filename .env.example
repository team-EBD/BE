# ===== 앱 =====
APP_ENV=local
API_V1_PREFIX=/v1

# ===== 데이터베이스 =====
# docker-compose 기준 기본값 (컨테이너 간 통신 시 host=db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eatlog
POSTGRES_PASSWORD=eatlog
POSTGRES_DB=eatlog
# 위 값으로 조합된 URL을 직접 덮어쓰고 싶으면 지정 (없으면 위 값으로 자동 조합)
# DATABASE_URL=postgresql+psycopg://eatlog:eatlog@localhost:5432/eatlog

# ===== 자체 JWT (Phase 2에서 사용) =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== 소셜 로그인 (Phase 2에서 사용) =====
GOOGLE_CLIENT_ID=
# Sign in with Apple — identityToken 의 aud 검증용 iOS 앱 번들 ID.
# 비우면 aud 검증이 생략되므로 운영에서는 반드시 설정할 것.
APPLE_BUNDLE_ID=

# ===== AI 서버 연동 (Phase 8에서 사용) =====
# BE → AI 서버(/internal/analyze·/internal/recommend) → Gemini.
# AI 서버는 내부용이며 기본 8000을 쓰므로 BE와 겹치지 않게 8001 등으로 띄운다.
AI_SERVER_BASE_URL=http://localhost:8001
AI_REQUEST_TIMEOUT_SECONDS=20
# mock: AI 서버 없이 고정 응답(개발/테스트) / real: 실제 AI 서버 호출
AI_CLIENT_MODE=real

# ===== 일일 AI 사용량 제한 (사용자당. 0 이하 = 무제한) =====
ANALYZE_DAILY_LIMIT=10
RECOMMEND_DAILY_LIMIT=10
# 하루 경계 시각(KST). 6 = 06:00~다음날 06:00 을 '하루'로 취급 —
# 캘린더/요약/사용량 리셋이 모두 이 기준을 쓴다 (기본 6, 바꿀 일 거의 없음)
DAY_START_HOUR=6
# 요청 타이밍 계측(request_logs) 기록 여부 (기본 true)
REQUEST_LOG_ENABLED=true

# ===== 푸시 발송 =====
# PUSH_BACKEND: mock(로그만, dev/테스트) | fcm(Firebase Cloud Messaging, 운영)
# fcm 은 아래 Firebase 자격증명(FIREBASE_CREDENTIALS_*)을 재사용한다.
PUSH_BACKEND=mock
# 주간 리포트 도착 푸시 — 매주 지정 요일(mon~sun)·시각(KST) 발송.
# 기본 일요일 09:00: 리포트 주 단위(일~토)가 완결된 직후 아침.
WEEKLY_REPORT_PUSH_ENABLED=true
WEEKLY_REPORT_PUSH_DAY=sun
WEEKLY_REPORT_PUSH_TIME=09:00

# ===== 메일 발송 (비밀번호 재설정 인증코드) =====
# EMAIL_BACKEND: mock(로그만, dev/테스트) | smtp(Gmail 등 SMTP, 운영)
# Gmail 은 계정 비밀번호가 아닌 "앱 비밀번호"(2단계 인증 필요)를 SMTP_PASSWORD 에 넣는다.
EMAIL_BACKEND=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 발신 주소 표시용 (비우면 SMTP_USER 사용)
MAIL_FROM=
# 인증코드 정책 (분 / 회)
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_CODE_MAX_ATTEMPTS=5

# ===== 이미지 스토리지 (Phase 4) =====
# STORAGE_BACKEND: local(로컬 디스크, /static 으로 서빙) | firebase(Firebase Storage)
STORAGE_BACKEND=local
STORAGE_DIR=./uploads
STORAGE_BASE_URL=http://localhost:8000/static

# ===== Firebase Storage (STORAGE_BACKEND=firebase 일 때 사용) =====
# 버킷 이름 (보통 <project-id>.appspot.com)
FIREBASE_STORAGE_BUCKET=
# 자격증명: 아래 둘 중 하나만 채운다. 둘 다 비면 ADC 로 폴백.
#   - 서비스 계정 JSON 문자열 (배포 환경변수용, 한 줄로)
FIREBASE_CREDENTIALS_JSON=
#   - 서비스 계정 JSON 파일 경로
FIREBASE_CREDENTIALS_FILE=

