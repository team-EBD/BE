# ===== 앱 =====
APP_ENV=local
API_V1_PREFIX=/v1

# ===== 데이터베이스 =====
# docker-compose 기준 기본값 (컨테이너 간 통신 시 host=db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eatlog
POSTGRES_PASSWORD=eatlog
POSTGRES_DB=eatlog
# 위 값으로 조합된 URL을 직접 덮어쓰고 싶으면 지정 (없으면 위 값으로 자동 조합)
# DATABASE_URL=postgresql+psycopg://eatlog:eatlog@localhost:5432/eatlog

# ===== 자체 JWT (Phase 2에서 사용) =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== 소셜 로그인 (Phase 2에서 사용) =====
GOOGLE_CLIENT_ID=

# ===== AI 서버 연동 (Phase 8에서 사용) =====
# BE → AI 서버(/internal/analyze·/internal/recommend) → Gemini.
# AI 서버는 내부용이며 기본 8000을 쓰므로 BE와 겹치지 않게 8001 등으로 띄운다.
AI_SERVER_BASE_URL=http://localhost:8001
AI_REQUEST_TIMEOUT_SECONDS=20
# mock: AI 서버 없이 고정 응답(개발/테스트) / real: 실제 AI 서버 호출
AI_CLIENT_MODE=real

# ===== 이미지 스토리지 (Phase 4) =====
# dev 는 로컬 디스크(/static 으로 서빙). 운영은 S3 호환 스토리지로 교체 예정.
STORAGE_DIR=./uploads
STORAGE_BASE_URL=http://localhost:8000/static
